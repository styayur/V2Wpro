{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorldIR 1.0",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "theme": {
      "type": "string",
      "minLength": 1
    },
    "coordinates": {
      "const": "right-handed Y-up meters; forward -Z"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "prototype": {
      "enum": [
        "arcade",
        "island",
        "gate"
      ]
    },
    "style": {
      "type": "object",
      "properties": {
        "sky": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "stone": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "light": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 5
        }
      },
      "required": [
        "sky",
        "stone",
        "accent",
        "light"
      ],
      "additionalProperties": false
    },
    "rules": {
      "type": "object",
      "properties": {
        "length": {
          "type": "number",
          "minimum": 12,
          "maximum": 128
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "clearance": {
          "type": "number",
          "minimum": 4,
          "maximum": 24
        },
        "variation": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      },
      "required": [
        "length",
        "rows",
        "clearance",
        "variation"
      ],
      "additionalProperties": false
    },
    "topology": {
      "type": "object",
      "properties": {
        "type": {
          "const": "linear-corridor"
        },
        "halfWidth": {
          "type": "number",
          "minimum": 6,
          "maximum": 64
        }
      },
      "required": [
        "type",
        "halfWidth"
      ],
      "additionalProperties": false
    },
    "streaming": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      },
      "required": [
        "count",
        "radius"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "instances": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "pixelRatio": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        }
      },
      "required": [
        "instances",
        "pixelRatio"
      ],
      "additionalProperties": false
    },
    "motion": {
      "type": "object",
      "properties": {
        "camera": {
          "const": "first-person"
        },
        "speed": {
          "type": "number",
          "minimum": 1,
          "maximum": 25
        },
        "action": {
          "enum": [
            "flight",
            "survey",
            "dash"
          ]
        }
      },
      "required": [
        "camera",
        "speed",
        "action"
      ],
      "additionalProperties": false
    },
    "physics": {
      "type": "object",
      "properties": {
        "radius": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1
        },
        "collision": {
          "const": "sphere-aabb"
        }
      },
      "required": [
        "radius",
        "collision"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "pattern": "^assets/[a-zA-Z0-9_-]+\\.(glb|gltf)$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "uri",
          "source",
          "license"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "observation",
              "inference",
              "decision",
              "extension"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "kind",
          "source",
          "claim",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "version",
    "name",
    "theme",
    "coordinates",
    "seed",
    "prototype",
    "style",
    "rules",
    "topology",
    "streaming",
    "budget",
    "motion",
    "physics",
    "assets",
    "evidence",
    "unknowns",
    "extensions"
  ],
  "additionalProperties": false
}
