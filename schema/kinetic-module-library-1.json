{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "title":"Kinetic module library v1",
  "type":"object","required":["format","units","axes","chunkSize","modules"],
  "properties":{
    "format":{"const":"kinetic-module-library-1"},"units":{"const":"metres"},"axes":{"const":"right-handed-y-up"},
    "chunkSize":{"type":"number","exclusiveMinimum":0,"maximum":4096},
    "modules":{"type":"array","minItems":1,"maxItems":64,"items":{"allOf":[{"$ref":"#/definitions/sweep"},{
      "type":"object","required":["width","collisionTolerance","renderTolerance","sockets","shells","source","license"],
      "properties":{"width":{"type":"number","exclusiveMinimum":0},"collisionTolerance":{"type":"number","exclusiveMinimum":0},
        "renderTolerance":{"type":"number","exclusiveMinimum":0},"source":{"type":"string","maxLength":256},"license":{"type":"string","maxLength":80},
        "sockets":{"type":"object","required":["entry","exit"],"properties":{"entry":{"$ref":"#/definitions/socket"},"exit":{"$ref":"#/definitions/socket"}}},
        "shells":{"type":"array","maxItems":8,"items":{"$ref":"#/definitions/sweep"}}}
    }]}}
  },
  "definitions":{
    "v3":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number","minimum":-16384,"maximum":16384}},
    "socket":{"type":"object","required":["center","forward","up","width"],"properties":{
      "center":{"$ref":"#/definitions/v3"},"forward":{"$ref":"#/definitions/v3"},"up":{"$ref":"#/definitions/v3"},"width":{"type":"number","exclusiveMinimum":0}}},
    "section":{"type":"array","minItems":2,"maxItems":128,"items":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number","minimum":-4096,"maximum":4096}}},
    "rows":{"type":"array","minItems":2,"maxItems":4096,"items":{"type":"object","required":["t","center","right","up"],"properties":{
      "t":{"type":"number","minimum":0,"maximum":1},"center":{"$ref":"#/definitions/v3"},"right":{"$ref":"#/definitions/v3"},"up":{"$ref":"#/definitions/v3"},"section":{"$ref":"#/definitions/section"}}}},
    "sweep":{"type":"object","required":["id","section","closedSection","stations","collisionStations"],"properties":{
      "id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},"section":{"$ref":"#/definitions/section"},"closedSection":{"type":"boolean"},
      "stations":{"$ref":"#/definitions/rows"},"collisionStations":{"$ref":"#/definitions/rows"}}}
  }
}
